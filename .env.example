# ───────── سُؤال AI — متغيرات البيئة ─────────
# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git أبداً.

# قاعدة البيانات (PostgreSQL 16+)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sual?schema=public"

# رابط الموقع العام (https في الإنتاج)
APP_URL="http://localhost:3000"

# سر عشوائي ≥ 32 حرفاً — مطلوب من المرحلة 1. توليده: openssl rand -base64 48
AUTH_SECRET=

# ── الذكاء الاصطناعي (المرحلة 3) ── مفتاح من console.anthropic.com
# الذكاء الاصطناعي: gemini (مجاني بحدود يومية، مفتاح من aistudio.google.com) أو anthropic
AI_PROVIDER="gemini"
GEMINI_API_KEY=
GEMINI_MODEL="gemini-flash-latest"
# احتياطي عند نفاد الحصة اليومية (مفصولة بفواصل)
GEMINI_FALLBACK_MODELS=
ANTHROPIC_API_KEY=
AI_MODEL="claude-opus-5-5"

# ── البريد الإلكتروني لرموز OTP (المرحلة 1) ── resend | smtp (EMAIL_FROM مطلوب في الحالتين)
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
# SMTP (بديل عن Resend: EMAIL_PROVIDER=smtp). مثال Gmail: smtp.gmail.com / 587 / SMTP_SECURE=false
# وكلمة المرور = App Password (يتطلب تفعيل التحقق بخطوتين) وليست كلمة مرور الحساب.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SMS وبوابة الدفع (المرحلة 5) ── تُحدَّد بعد اختيار المزوّد العراقي
SMS_PROVIDER=
PAYMENT_PROVIDER=

# مجلد تخزين الملفات المرفوعة (خارج public دائماً)
STORAGE_DIR="./storage"

# قراءة الكتب المصوّرة (OCR محلي). false لتعطيلها إن كان الجهاز ضعيفاً
OCR_ENABLED=true
# عدد خيوط OCR المتوازية (1–4). 1 للجهاز الضعيف/الساخن
OCR_WORKERS=2
# تصدير PDF يستعمل متصفحاً مثبّتاً (Edge أو Chrome على ويندوز تلقائياً). ضع المسار إن لم يُعثر عليه، مثلاً:
# CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMIUM_PATH=
